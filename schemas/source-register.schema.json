                      "reviewed"
                    ]
                  },
                  "reviewer": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "date": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
