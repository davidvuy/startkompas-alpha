{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "startkompas-retrieval-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "source_revision",
    "query",
    "groups",
    "ids",
    "offset",
    "limit"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "query": {
      "type": "string",
      "maxLength": 1000
    },
    "groups": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10,
      "items": {
        "enum": [
          "profile",
          "facts",
          "assumptions",
          "sources",
          "decisions",
          "tasks",
          "checks",
          "artifacts",
          "evidence",
          "events"
        ]
      }
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  }
}
