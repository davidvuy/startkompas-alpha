{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "expected_revision",
    "operation_id",
    "at",
    "actor",
    "trigger",
    "reason",
    "domains"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "trigger": {
      "enum": [
        "intake",
        "milestone",
        "change"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain_id",
          "applicability",
          "rationale",
          "answers"
        ],
        "properties": {
          "domain_id": {
            "type": "string",
            "pattern": "^D(0[1-9]|1[0-5])$"
          },
          "applicability": {
            "enum": [
              "applies",
              "not_applicable",
              "unknown"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "answers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question_id",
                "answer",
                "source_ids",
                "note"
              ],
              "properties": {
                "question_id": {
                  "enum": [
                    "q1",
                    "q2"
                  ]
                },
                "answer": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 50,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "\\S"
                  }
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
