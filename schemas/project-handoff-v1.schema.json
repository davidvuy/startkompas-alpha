{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "startkompas-project-handoff-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "name",
    "revision",
    "schema_version",
    "canonical_sha256",
    "active_task",
    "decisions",
    "open_tasks",
    "unresolved_checks",
    "evidence",
    "artifacts",
    "summary",
    "retrieval",
    "invalidated_ids",
    "limitations"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "canonical_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "active_task": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "anyOf": [
            {
              "$ref": "dossier-v1.schema.json#/properties/tasks/items"
            },
            {
              "$ref": "dossier-v1.1.schema.json#/properties/tasks/items"
            }
          ]
        }
      ]
    },
    "decisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "anyOf": [
          {
            "$ref": "dossier-v1.schema.json#/properties/decisions/items"
          },
          {
            "$ref": "dossier-v1.1.schema.json#/properties/decisions/items"
          }
        ]
      }
    },
    "open_tasks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "anyOf": [
          {
            "$ref": "dossier-v1.schema.json#/properties/tasks/items"
          },
          {
            "$ref": "dossier-v1.1.schema.json#/properties/tasks/items"
          }
        ]
      }
    },
    "unresolved_checks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "anyOf": [
          {
            "$ref": "dossier-v1.schema.json#/properties/checks/items"
          },
          {
            "$ref": "dossier-v1.1.schema.json#/properties/checks/items"
          }
        ]
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "anyOf": [
          {
            "$ref": "dossier-v1.schema.json#/properties/evidence/items"
          },
          {
            "$ref": "dossier-v1.1.schema.json#/properties/evidence/items"
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "recorded_availability",
          "actual",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "recorded_availability": {
            "enum": [
              "available",
              "missing",
              "unknown"
            ]
          },
          "actual": {
            "enum": [
              "external_unchecked",
              "missing",
              "hash_matches",
              "hash_mismatch",
              "unreadable_or_unsafe"
            ]
          },
          "location": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit_per_section",
        "totals",
        "truncated"
      ],
      "properties": {
        "limit_per_section": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
