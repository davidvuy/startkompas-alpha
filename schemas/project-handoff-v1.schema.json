              "minimum": 0
            },
            "evidence": {
              "type": "integer",
              "minimum": 0
            },
            "artifacts": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
