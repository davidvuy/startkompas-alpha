{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "startkompas-cli-error-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "error"
  ],
  "properties": {
    "code": {
      "enum": [
        "INVALID_JSON",
        "ENOENT",
        "EACCES",
        "EPERM",
        "EEXIST",
        "DEPENDENCY_MISSING",
        "REVISION_CONFLICT",
        "PROJECT_MISMATCH",
        "OPERATION_CONFLICT",
        "COMMAND_FAILED"
      ]
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
