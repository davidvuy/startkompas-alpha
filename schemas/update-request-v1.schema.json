{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "startkompas-update-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "expected_revision",
    "operation_id",
    "changes"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "$ref": "dossier-v1.1.schema.json#/properties/profile"
        },
        "facts": {
          "$ref": "dossier-v1.1.schema.json#/properties/facts"
        },
        "assumptions": {
          "$ref": "dossier-v1.1.schema.json#/properties/assumptions"
        },
        "sources": {
          "$ref": "dossier-v1.1.schema.json#/properties/sources"
        },
        "decisions": {
          "$ref": "dossier-v1.1.schema.json#/properties/decisions"
        },
        "tasks": {
          "$ref": "dossier-v1.1.schema.json#/properties/tasks"
        },
        "checks": {
          "$ref": "dossier-v1.1.schema.json#/properties/checks"
        },
        "artifacts": {
          "$ref": "dossier-v1.1.schema.json#/properties/artifacts"
        },
        "evidence": {
          "$ref": "dossier-v1.1.schema.json#/properties/evidence"
        },
        "events": {
          "$ref": "dossier-v1.1.schema.json#/properties/events"
        },
        "active_task_id": {
          "$ref": "dossier-v1.1.schema.json#/properties/active_task_id"
        },
        "name": {
          "$ref": "dossier-v1.1.schema.json#/properties/name"
        },
        "skill_version": {
          "$ref": "dossier-v1.1.schema.json#/properties/skill_version"
        },
        "module_versions": {
          "$ref": "dossier-v1.1.schema.json#/properties/module_versions"
        },
        "workflow": {
          "$ref": "dossier-v1.1.schema.json#/properties/workflow"
        }
      }
    }
  }
}
