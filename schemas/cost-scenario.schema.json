{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "period",
    "unit",
    "currency",
    "source_note",
    "fixed_cents",
    "variable_cents_per_unit",
    "price_cents_per_unit",
    "units",
    "budget_cents",
    "excluded_costs"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "period": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "currency": {
      "const": "EUR"
    },
    "source_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "fixed_cents": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        {
          "type": "null"
        }
      ]
    },
    "variable_cents_per_unit": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        {
          "type": "null"
        }
      ]
    },
    "price_cents_per_unit": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        {
          "type": "null"
        }
      ]
    },
    "units": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "budget_cents": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        {
          "type": "null"
        }
      ]
    },
    "excluded_costs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "\\S"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
