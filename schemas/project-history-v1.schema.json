{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "startkompas-project-history-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "snapshots",
    "total_candidates",
    "truncated",
    "unrecognized_entries",
    "limitations"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshots": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision",
              "sha256",
              "name",
              "valid",
              "ambiguous"
            ],
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "ambiguous": {
                "type": "boolean"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "name": {
                "type": "string"
              },
              "valid": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision",
              "valid",
              "ambiguous",
              "error"
            ],
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "ambiguous": {
                "type": "boolean"
              },
              "valid": {
                "const": false
              },
              "error": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "total_candidates": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "unrecognized_entries": {
      "type": "integer",
      "minimum": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
