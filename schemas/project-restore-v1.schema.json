{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "startkompas-project-restore-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "directory",
    "file",
    "sha256",
    "dossier",
    "references"
  ],
  "properties": {
    "directory": {
      "$ref": "project-read-v1.schema.json#/properties/directory"
    },
    "file": {
      "$ref": "project-read-v1.schema.json#/properties/file"
    },
    "sha256": {
      "$ref": "project-read-v1.schema.json#/properties/sha256"
    },
    "dossier": {
      "$ref": "project-read-v1.schema.json#/properties/dossier"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "location",
          "reason"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
